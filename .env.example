# Copy to .env for local runs. .env is git-ignored: never commit secrets.

# Which config/environments/<name>.toml to use (dev, qa, staging, prod)
TEST_ENV=qa

# Secrets
API_TOKEN=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional one-off overrides of the environment file
# BASE_URL=
# API_BASE_URL=
# API_TIMEOUT=
# API_RETRIES=
# LOG_LEVEL=DEBUG
